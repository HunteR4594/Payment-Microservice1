using PaymentService.Data;
using PaymentService.Integrations;
using Services = PaymentService.Services;
using PaymentService.Controllers;
using dotenv.net;

var builder = WebApplication.CreateBuilder(args);

// Load environment variables from .env.local in development
if (builder.Environment.IsDevelopment())
{
    try
    {
        var envPath = Path.Combine(Directory.GetCurrentDirectory(), ".env.local");
        if (File.Exists(envPath))
        {
            DotEnv.Load();
        }
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Warning: Could not load .env.local: {ex.Message}");
    }
}

// 1. Add Services to container
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddSwaggerGen();
builder.Services.AddHttpClient(); // For PayMongo Adapter

// 2. Add CORS policy for frontend development
builder.Services.AddCors(options =>
{
    options.AddPolicy("AllowFrontend", policy =>
    {
        policy.WithOrigins(
                "http://localhost:5173",      // Vite dev server (default)
                "http://localhost:5174",      // Vite fallback port
                "http://localhost:5175",      // Vite fallback port
                "http://localhost:3000",      // Alternative dev server
                "http://localhost:5259"       // Backend itself
            )
            .AllowAnyHeader()
            .AllowAnyMethod()
            .AllowCredentials();
    });
});

// 3. Register Your Custom Classes
builder.Services.AddScoped<PaymentRepository>();
builder.Services.AddScoped<PayMongoAdapter>();
builder.Services.AddScoped<Services.PaymentService>();

var app = builder.Build();

// 4. Configure Pipeline
if (app.Environment.IsDevelopment())
{
    app.UseSwagger();
    app.UseSwaggerUI();
}

if (!app.Environment.IsDevelopment())
{
    app.UseHttpsRedirection();
}

// 5. Use CORS middleware
app.UseCors("AllowFrontend");

// Minimal diagnostics
app.Lifetime.ApplicationStarted.Register(() => Console.WriteLine("Application started successfully"));
app.Lifetime.ApplicationStopping.Register(() => Console.WriteLine("Application is shutting down"));
app.Lifetime.ApplicationStopped.Register(() => Console.WriteLine("Application stopped"));

// 6. Map the Endpoints
// Health check endpoint
app.MapGet("/health", () => Results.Ok(new { status = "healthy", timestamp = DateTime.UtcNow }))
    .WithName("Health");

// Map real and mock payment endpoints
try
{
    app.MapPaymentRoutes(); // Real endpoints
    app.MapMockPaymentRoutes();
}
catch (Exception ex)
{
    Console.WriteLine($"Error mapping routes: {ex.Message}");
}

app.Run();